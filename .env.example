# ============================================================
# SpaceBasic WhatsApp Bot — Secret Credentials
# ============================================================
# COPY THIS FILE TO .env AND FILL IN YOUR DETAILS
# NEVER SHARE OR COMMIT .env
# ============================================================

# --- SpaceBasic Web Portal ---
SPACEBASIC_URL=https://portal.spacebasic.com
SPACEBASIC_BOOKING_URL=https://portal.spacebasic.com/module/messmanager/bookings
SPACEBASIC_USERNAME=your_student_id@college.edu
SPACEBASIC_PASSWORD=your_password

# --- Twilio WhatsApp (get these from console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your personal WhatsApp (ONLY this number can send commands)
MY_WHATSAPP_NUMBER=whatsapp:+91XXXXXXXXXX

# --- Live booking gate ---
LIVE_BOOKING_ENABLED=false

